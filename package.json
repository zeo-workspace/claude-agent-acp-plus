{
  "name": "@lucascouts/claude-agent-acp-plus",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.25.2",
  "description": "Claude Code in Zed and other ACP clients with the VS Code extension's UX — multi-select questions, refusal consent, live quota windows, background tasks, Ultracode effort and session notices. Fork of claude-agent-acp.",
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "bin": {
    "claude-agent-acp-plus": "dist/index.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./*": "./*"
  },
  "files": [
    "dist/",
    "!dist/tests/",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npm run build && npm run start",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "release:preflight": "bash scripts/release-preflight.sh",
    "release:attest": "bash scripts/ci-attest.sh",
    "ci:local": "npm run format:check && npm run lint && npm run build && npm run test:run",
    "test": "vitest",
    "test:integration": "RUN_INTEGRATION_TESTS=true vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:shell": "bats scripts/tests",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "acp",
    "agent-client-protocol",
    "agent",
    "anthropic",
    "zed",
    "typescript",
    "sdk"
  ],
  "homepage": "https://github.com/zeo-workspace/claude-agent-acp-plus#readme",
  "bugs": {
    "url": "https://github.com/zeo-workspace/claude-agent-acp-plus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeo-workspace/claude-agent-acp-plus.git"
  },
  "author": "Zed Industries",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.285",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@eslint/js": "10.0.1",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "26.6.2",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
